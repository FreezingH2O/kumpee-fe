# คำภีร์ frontend — backend connection.
# Copy to .env.local and fill in. Only the NEXT_PUBLIC_SUPABASE_* values may be
# public; KAMPHEE_GUEST_API_TOKEN and the Upstash values are server-side only — never give it a NEXT_PUBLIC prefix.

# Base URL of the คำภีร์ backend, WITHOUT a trailing /v1.
# Defaults to the deployed backend when unset.
#   deployed:   https://kumpee-be.vercel.app
#   local:      http://localhost:8000
KAMPHEE_API_BASE=https://kumpee-be.vercel.app

# Supabase Auth — the login page. The backend verifies these users' JWTs
# (thai-dic KAMPHEE_AUTH_ISSUER). The anon/publishable key is public by design;
# copy it from Supabase → Project Settings → API Keys. NEVER put the
# service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://ywbvftgqxttodiybvhvs.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public address of this site, used in sign-up confirmation / email sign-in
# links. Also set Supabase → Authentication → URL Configuration → Site URL to it
# and add <this>/auth/callback to the Redirect URLs.
# Optional on Vercel: the production domain is detected automatically.
NEXT_PUBLIC_SITE_URL=https://kumpee.vercel.app

# Free AI trial for signed-out visitors (server-side only).
# A `kh_` API key with ONLY the language:use scope, created by a signed-in user
# via POST /v1/api-keys. Leave empty to disable the guest trial (AI needs login).
KAMPHEE_GUEST_API_TOKEN=
# Free AI searches per visitor per day (Thailand time). Default 3.
KAMPHEE_GUEST_DAILY_LIMIT=3
# Upstash Redis counts guest usage (Vercel → Storage/Marketplace → Upstash for
# Redis sets these automatically; KV_REST_API_URL/KV_REST_API_TOKEN also work).
# In production the guest trial stays OFF unless Redis is configured.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: enable the staff-only reviewer panel on เสนอคำ (default off / public build, §5).
# NEXT_PUBLIC_ENABLE_REVIEWER_PANEL=1
